# Database - PostgreSQL connection string (Supabase, Neon, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/trendspark"

# Public URL of the deployed app (used to build Stripe redirect/callback URLs).
# Locally this can stay as-is; in production set it to your real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic (Claude) API
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# Stripe
# Secret key from https://dashboard.stripe.com/apikeys (use a restricted/test key while developing)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for the /api/stripe/webhook endpoint (from the Stripe CLI or the Dashboard webhook config)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs (not Product IDs) for the recurring Pro/Business subscription prices
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_BUSINESS="price_..."
