# Database - PostgreSQL connection string (Supabase, Neon, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/trendspark"

# Public URL of the deployed app (used to build Stripe redirect/callback URLs).
# Locally this can stay as-is; in production set it to your real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The one account email that can reach /admin (see src/lib/admin.ts).
ADMIN_EMAIL=""

# Google Gemini API - get a key at https://aistudio.google.com/apikey
# (a billing account must be enabled on the Google AI project to use the API)
GEMINI_API_KEY="AI..."
GEMINI_MODEL="gemini-2.5-flash"

# Stripe
# Secret key from https://dashboard.stripe.com/apikeys (use a restricted/test key while developing)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for the /api/stripe/webhook endpoint (from the Stripe CLI or the Dashboard webhook config)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs (not Product IDs) for the recurring Pro/Business subscription prices
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_BUSINESS="price_..."

# Email (password reset). Uses Resend when set; otherwise reset links are
# printed to the server console so local dev works without an email provider.
# Get a key at https://resend.com and verify your sending domain for production.
RESEND_API_KEY=""
EMAIL_FROM="TrendSpark AI <noreply@yourdomain.com>"

# Rate limiting. Uses Upstash Redis when both are set (recommended for
# serverless/Vercel); otherwise falls back to an in-memory limiter (fine for
# local dev and single-instance deployments). https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
