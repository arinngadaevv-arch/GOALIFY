# Database - PostgreSQL connection string (Supabase, Neon, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/trendspark"

# Public URL of the deployed app (used to build the Lemon Squeezy checkout
# redirect_url). Locally this can stay as-is; in production set it to your
# real domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage — public bucket named "videos" holding the workout
# player's real clips (intro.mp4, exercise-1.mp4, exercise-2.mp4, ...,
# water.mp4, outro.mp4 — see src/lib/goalify/video.ts for the exact
# naming convention). This is just the project's base URL, not a secret,
# so it's safe as a browser-exposed NEXT_PUBLIC_ var. The "videos" bucket
# itself must have public read access enabled in the Supabase dashboard
# (Storage > videos > bucket settings) or these URLs 404/403 — the player
# falls back to its built-in placeholder animation if a clip fails to load.
NEXT_PUBLIC_SUPABASE_URL="https://pejahrcnipnstcdxzodz.supabase.co"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Optional Google OAuth. GOOGLE_CLIENT_ID/SECRET is the primary name this
# app looks for, but auth.ts also accepts AUTH_GOOGLE_ID/SECRET (Auth.js v5's
# own auto-detection convention) and GOOGLE_ID/SECRET as fallbacks, so
# whichever naming Vercel's env vars ended up using still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional extra account email that can reach /admin (see src/lib/admin.ts) -
# useful for a staging deployment. The real owner's email is hardcoded there
# directly, so this is only needed to grant access to another address.
ADMIN_EMAIL=""

# Google Gemini API - get a key at https://aistudio.google.com/apikey
# (a billing account must be enabled on the Google AI project to use the API)
GEMINI_API_KEY="AI..."
GEMINI_MODEL="gemini-2.5-flash"

# Lemon Squeezy — the paywall's real checkout/payment processor.
# API key: Settings > API in the Lemon Squeezy dashboard.
LEMONSQUEEZY_API_KEY=""
# Store ID: Settings > Stores (the number next to your store name).
LEMONSQUEEZY_STORE_ID=""
# Signing secret set when you create the webhook below (any value you choose).
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Variant IDs for the three paywall tiers (Products > [product] > variant,
# the id is in the variant's URL/API response) — one per pricing tier. Each
# variant MUST be configured in the Lemon Squeezy dashboard to charge EXACTLY
# the price below (src/lib/goalify/pricing.ts is the source of truth the app
# checks against) — the checkout API refuses to start checkout if the
# variant's actual configured price doesn't match, so a mismatch here shows
# up as a 502 on the paywall rather than silently over/undercharging anyone.
# Monthly must be configured to charge $19.99, billed monthly.
LEMONSQUEEZY_VARIANT_ID_MONTHLY=""
# Quarterly must be configured to charge $29.99, billed every 3 months.
LEMONSQUEEZY_VARIANT_ID_QUARTERLY=""
# Annual must be configured to charge $39.99, billed annually.
LEMONSQUEEZY_VARIANT_ID_ANNUAL=""
# Fallback used for any tier above left blank — lets checkout go live off a
# single Lemon Squeezy variant before the other two are set up. IMPORTANT: a
# variant only has one real price, and the price-match check above still
# applies, so only the ONE tier whose advertised price equals this variant's
# actual configured price will successfully reach checkout; the other two
# will keep 502ing ("This plan isn't available right now") by design, since
# this app will never silently charge a customer a different amount than the
# paywall showed them. Set the tier-specific vars above once the other two
# real variants exist.
LEMONSQUEEZY_VARIANT_ID=""
# In the Lemon Squeezy dashboard, add a webhook (Settings > Webhooks)
# pointing at {NEXT_PUBLIC_APP_URL}/api/webhooks/lemonsqueezy, subscribed to
# at least the "order_created" event, signed with LEMONSQUEEZY_WEBHOOK_SECRET.

# Whop — the paywall's checkout flow, separate from the Lemon Squeezy flow
# above (see paywall.tsx / api/checkout/whop). A per-user Whop checkout is
# created server-side for every purchase, so payments auto-credit the right
# account the same way the Lemon Squeezy flow does — no manual /admin step
# needed for a normal Whop purchase.
#
# API key: Whop dashboard > Developer > API Keys. Needs permission to create
# checkout configurations for the plans below (see api/checkout/whop/route.ts)
# — checkout_configuration:create at minimum.
WHOP_API_KEY=""
# Plan IDs for the three paywall tiers (Whop dashboard > your product > the
# specific plan > its id, same "plan_..." format as plan_gMVdfDFjDAdqL, the
# id that used to be the paywall's static checkout link) — one per pricing
# tier, same three tiers as the Lemon Squeezy variants above. There's no
# equivalent of the Lemon Squeezy price-match check for these (see the
# getWhopPlanId doc comment in lib/whop.ts for why) — double check each
# plan is actually configured to charge what src/lib/goalify/pricing.ts
# advertises, since nothing here will catch a mismatch automatically.
# Monthly should be configured to charge $19.99, billed monthly.
WHOP_PLAN_ID_MONTHLY=""
# Quarterly should be configured to charge $29.99, billed every 3 months.
WHOP_PLAN_ID_QUARTERLY=""
# Annual should be configured to charge $39.99, billed annually.
WHOP_PLAN_ID_ANNUAL=""
# Fallback used for any tier above left blank — lets checkout go live off a
# single Whop plan before the other two are set up. Every tier left on this
# fallback reuses the SAME plan (and therefore the same real price) rather
# than 502ing the way an unmatched Lemon Squeezy tier does — there's no
# per-tier price check to fail closed on, so don't rely on this beyond
# getting one tier working first.
WHOP_PLAN_ID=""
# Webhook signing secret: Whop dashboard > Developer > Webhooks > create a
# webhook pointing at {NEXT_PUBLIC_APP_URL}/api/webhooks/whop, subscribed to
# at least "payment.succeeded" — Whop shows the signing secret once, at
# creation time. Paste ONLY into this env var (Vercel project settings for
# production, this file locally) — never into chat or committed anywhere.
WHOP_WEBHOOK_SECRET=""

# Email (password reset). Uses Resend when set; otherwise reset links are
# printed to the server console so local dev works without an email provider.
# Get a key at https://resend.com and verify your sending domain for production.
RESEND_API_KEY=""
EMAIL_FROM="GOALIFY <noreply@yourdomain.com>"

# Rate limiting. Uses Upstash Redis when both are set (recommended for
# serverless/Vercel); otherwise falls back to an in-memory limiter (fine for
# local dev and single-instance deployments). https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
