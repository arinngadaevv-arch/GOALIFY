# Postgres connection string (Supabase/Neon/Vercel Postgres/local)
DATABASE_URL=postgres://user:password@localhost:5432/ai_store_manager

# Shopify Partner app credentials (Partner Dashboard > Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated Admin API scopes. Keep this to only what current features need.
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_content,read_themes

# Public URL this app is served from (used to build the OAuth redirect_uri).
# Use your ngrok/Vercel URL in development.
SHOPIFY_APP_URL=http://localhost:3000

# AI provider for one-click fix content generation (titles, descriptions,
# SEO metadata, ALT text). The scanner itself is rule-based and works without
# this, but "Fix it" buttons for content fixes will return an error until set.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8
AI_MODEL=
